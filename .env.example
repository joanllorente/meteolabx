# Copy the required names into Railway Variables or a local, ignored .env.
# Never commit real values.

METEOLABX_AEMET_API_KEY=
METEOLABX_METEOCAT_API_KEY=
METEOLABX_METEOFRANCE_API_KEY=
METEOLABX_AROME_API_KEY=
METEOLABX_METOFFICE_API_KEY=
METEOLABX_WINDY_API_KEY=
METEOLABX_NETATMO_CLIENT_ID=
METEOLABX_NETATMO_CLIENT_SECRET=
METEOLABX_NETATMO_REFRESH_TOKEN=
METEOLABX_FROST_CLIENT_ID=
METEOLABX_FROST_CLIENT_SECRET=

# Aplicación Svelte independiente que se abre desde Predicción · Beta.
METEOLABX_FORECAST_URL=/forecast

# Pipeline incremental AROME. En Railway, web y worker se ejecutan en el mismo
# servicio y persisten los frames en el volumen conectado. Activa
# PRECOMPUTED_ONLY cuando el worker ya esté publicando frames.
METEOLABX_FORECAST_PRECOMPUTED_ONLY=false
METEOLABX_FORECAST_CATALOG_REFRESH_S=60
# Vacío = Cataluña en local y dominio completo en Railway. Puede fijarse
# explícitamente a `catalonia` o `model`.
METEOLABX_FORECAST_CALCULATION_SCOPE=
METEOLABX_FORECAST_WORKER_WATCH=true
METEOLABX_FORECAST_WORKER_INTERVAL_S=300
# Procesos en paralelo del worker. HEAVY_WORKERS son los perfiles convectivos,
# que dominan la memoria: subirlo acelera el nivel más lento, pero cada proceso
# carga su propio perfil. Con el troceado por bandas el pico ronda 1,4 GB, así
# que 2 es el salto razonable; comprobar la memoria del contenedor antes de más.
METEOLABX_FORECAST_WORKERS=6
METEOLABX_FORECAST_HEAVY_WORKERS=1
# Filas de rejilla que se diagnostican de una vez. Por debajo de 120 el DCAPE
# deja de ser reproducible (SHARPpy es sensible al conjunto de celdas).
METEOLABX_FORECAST_CONVECTIVE_STRIPE_ROWS=192
# Ruta opcional local; en Railway se deriva del volumen automáticamente:
METEOLABX_FORECAST_STORE_PATH=

# En producción se deja activo. Para desarrollo local y tests se desactiva
# automáticamente desde scripts/run_server.sh y tests/backend/conftest.py.
METEOLABX_RANKING_REFRESH_ENABLED=true

# Euskalmet: use a pre-generated JWT, or configure a private key path.
METEOLABX_EUSKALMET_JWT=
METEOLABX_EUSKALMET_API_KEY=
METEOLABX_EUSKALMET_PRIVATE_KEY_PATH=
METEOLABX_EUSKALMET_JWT_ISS=meteolabx
METEOLABX_EUSKALMET_JWT_EMAIL=

# POEM authentication is optional depending on the selected endpoint.
METEOLABX_POEM_BEARER_TOKEN=
METEOLABX_POEM_API_KEY=
METEOLABX_POEM_BASIC_USER=
METEOLABX_POEM_BASIC_PASSWORD=

METEOLABX_CORS_ORIGINS=https://meteolabx.com

# Ritmo de descarga WCS. El limitador es global al contenedor y cuenta
# peticiones, no bytes: es el factor que domina el tiempo de una pasada.
# El perfil convectivo baja ~102 campos por hora de predicción.
# La suscripción AROME está en el tier 50PerMin (consta en el propio token):
# una petición cada 1,2 s. El limitador es un lock global al contenedor, así
# que este intervalo gobierna el ritmo total. 1,25 s deja 48/min, con margen.
# Bajarlo no acelera: cada 429 son cuatro reintentos y un mapa aplazado.
METEOLABX_AROME_REQUEST_INTERVAL_S=1.25
METEOLABX_AROME_PROFILE_REQUEST_INTERVAL_S=1.25
# Pasadas que se conservan en el volumen. Cada una ocupa ~1 GB; con cuatro no
# caben en un volumen de 5 GB y el worker se queda sin poder escribir.
METEOLABX_FORECAST_RETAINED_RUNS=3
# Horizonte de las cizalladuras y los diagnósticos convectivos. Un campo nativo
# cuesta segundos y una hora convectiva varios minutos, así que se recorta solo
# donde duele: los nativos siguen cubriendo la pasada entera.
METEOLABX_FORECAST_DIAGNOSTIC_MAX_HOURS=36

# Credencial OAuth del portal para la API de paquetes AROME. El portal mantiene
# un único token vivo por aplicación —emitir uno nuevo invalida el anterior—,
# así que el token se comparte entre procesos mediante un fichero con cerrojo.
METEOLABX_METEOFRANCE_APPLICATION_ID=
# Ruta opcional del token compartido; por defecto va al temporal del sistema.
METEOLABX_METEOFRANCE_TOKEN_CACHE=
# Paquetes GRIB2 de AROME: se descargan al temporal del contenedor, nunca al
# volumen (cada bloque son ~520 MB) y se borran al rotar la pasada.
METEOLABX_AROME_PACKAGE_CACHE_DIR=
# Horizonte que se espera de una pasada completa. Fija el denominador del
# progreso: contando solo las horas ya publicadas, el porcentaje retrocedia
# mientras AROME seguia entregando plazos.
METEOLABX_FORECAST_EXPECTED_HOURS=52
# Cache de bloques de GDAL al leer los paquetes GRIB. Su valor por defecto es
# un porcentaje de la RAM de la maquina y se queda con ~900 MB por proceso,
# memoria que necesita el diagnostico convectivo. Acotarlo no cuesta tiempo.
METEOLABX_GDAL_CACHE_MB=64
# Filas por banda cuando DCAPE queda fuera (su turno lo calcula aparte). Los
# otros trece diagnosticos son celda a celda y toleran bandas estrechas: 64
# recorta ~1 GB del pico sin coste en tiempo ni cambio en el resultado.
METEOLABX_FORECAST_CONVECTIVE_STRIPE_ROWS_NO_DCAPE=64
# Aparta los perfiles apilados (~800 MB) a un fichero mapeado en el temporal
# del contenedor durante el diagnostico convectivo. Se desactiva solo si el
# temporal es un tmpfs, donde no liberaria nada. Poner a 0 para forzar RAM.
METEOLABX_FORECAST_PROFILE_SPILL=1
# Bloques GRIB que se adelantan en segundo plano. Ocho cubren una pasada
# entera (~5 GB en el temporal del contenedor): se bajan mientras los niveles
# 0 y 1 calculan, de modo que los perfiles convectivos los encuentren hechos.
# A 0 se desactiva el adelanto.
METEOLABX_FORECAST_PREFETCH_BLOCKS=8
# Espera entre reintentos cuando un bloque GRIB todavia no esta publicado, y
# tiempo maximo persiguiendolos antes de rendirse al WCS. Al principio de una
# pasada los bloques largos tardan en aparecer y la cizalladura los adelanta.
METEOLABX_FORECAST_PREFETCH_RETRY_S=45
METEOLABX_FORECAST_PREFETCH_DEADLINE_S=600
